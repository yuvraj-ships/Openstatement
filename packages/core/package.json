{
  "name": "openstatement",
  "version": "0.2.0",
  "description": "Parse bank statement PDFs from any bank into structured transactions. Merge months, find subscriptions. Runs in the browser and Node. Exports CSV, OFX, QIF and JSON.",
  "license": "MIT",
  "author": "yuvraj-ships (https://github.com/yuvraj-ships)",
  "homepage": "https://yuvraj-ships.github.io/Openstatement/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuvraj-ships/Openstatement.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/yuvraj-ships/Openstatement/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "bank-statement",
    "pdf",
    "csv",
    "ofx",
    "qif",
    "finance",
    "budgeting",
    "privacy",
    "parser"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "pdfjs-dist": "^6.5.438"
  }
}
